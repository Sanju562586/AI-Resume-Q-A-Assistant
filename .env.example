# ─────────────────────────────────────────────────────────────
# AI Resume Q&A Assistant – Environment Variables
# Copy this file to .env and fill in your actual keys
# ─────────────────────────────────────────────────────────────

# Gemini API Key (get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key as fallback
# OPENAI_API_KEY=your_openai_api_key_here

# CORS allowed origins (Next.js dev server)
ALLOWED_ORIGINS=http://localhost:3000
