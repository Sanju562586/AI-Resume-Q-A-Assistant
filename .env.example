# ─────────────────────────────────────────────────────────────────────────────
# AI Resume Q&A Assistant – Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual API keys below
#   3. Never commit your .env file to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Primary LLM: Google Gemini (recommended – has a free tier) ────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Fallback LLM: OpenAI (optional – used if Gemini key is absent) ────────────
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# ── CORS: Comma-separated list of allowed frontend origins ───────────────────
# Default: Next.js dev server on port 3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Server settings (optional overrides) ─────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
